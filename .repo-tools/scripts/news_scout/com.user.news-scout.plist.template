<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.news-scout</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO_ROOT__/.repo-tools/.venv/bin/python3</string>
        <string>-m</string>
        <string>news_scout.news_scout</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__/.repo-tools/scripts</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>

    <!-- Every ~5 days: days 1, 6, 11, 16, 21, 26 at 08:00. ONE slot per run day.
         NO hourly retry slots — a failed run (no network, API error) waits for
         the next scheduled slot rather than retrying. Repeated retries after a
         broken dedup guard are what caused the Aug-2026 overspend. Re-running
         early is a human decision: python3 -m news_scout.news_scout --force
         A hard ceiling of 6 runs / trailing 7 days is enforced in the script
         itself (MAX_RUNS_PER_WEEK), covering every trigger path and machine. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Day</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Day</key><integer>6</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Day</key><integer>11</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Day</key><integer>16</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Day</key><integer>21</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Day</key><integer>26</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <!-- RunAtLoad disabled: with a twice-weekly schedule it would otherwise fire
         on every login regardless of weekday. launchd still runs a missed Tue/Thu
         slot once after wake if the laptop was asleep at the scheduled time. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__REPO_ROOT__/.repo-tools/logs/news_scout.log</string>

    <key>StandardErrorPath</key>
    <string>__REPO_ROOT__/.repo-tools/logs/news_scout.log</string>
</dict>
</plist>
